# Template for android/debug_keystore.properties (git-ignored), read by
# dsp_base's android/build.gradle.kts. settings.gradle.kts copies this file
# when the real one is missing, so a fresh clone or CI can build.
# appCheckKey / secretKey must be 16 chars (AES-128). Any values work while
# Firebase App Check is off; put the team's values here if it is turned on.
appCheckToken=replace_with_app_check_token
appCheckKey=0123456789abcdef
secretToken=replace_with_secret
secretKey=fedcba9876543210
